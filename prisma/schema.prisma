generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  RECRUITER
  SCHOOL
  COLLEGE
  PARENT
  COMPANY
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?

  @@map("users")
}

model StudentProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  meritixId       String    @unique
  admissionNumber String?
  firstName       String
  middleName      String?
  lastName        String
  gender          String?
  dob             DateTime?
  phone           String?
  alternatePhone  String?
  bloodGroup      String?
  nationality     String?
  religion        String?
  category        String?
  aadhaar         String?
  photo           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_years")
}

model Board {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String  @unique
  description String?
  website     String?
  country     String  @default("India")
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools School[]

  @@map("boards")
}

model Subject {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String  @unique
  shortName   String?
  description String?
  category    String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

model School {
  id Int @id @default(autoincrement())

  code String @unique
  name String

  boardId Int
  board   Board @relation(fields: [boardId], references: [id], onDelete: Restrict)

  udiseCode     String? @unique
  affiliationNo String?

  principalName String?

  email   String?
  phone   String?
  website String?

  address String?
  city    String?
  state   String?
  country String  @default("India")
  pincode String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  establishedYear Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
  @@index([city])
  @@index([state])
  @@map("schools")
}
