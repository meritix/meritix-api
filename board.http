  "country": "India",
  "isActive": true
}


### 3. Create ICSE board

POST {{baseUrl}}/boards
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "ICSE",
  "name": "Indian Certificate of Secondary Education",
  "description": "School education board administered by CISCE.",
  "website": "https://cisce.org",
  "country": "India",
  "isActive": true
