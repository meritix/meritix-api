#############################################
### Meritix API - School Module
#############################################

@baseUrl = http://localhost:3000

############################################################
# AUTHENTICATION
############################################################

### Register User (Run only once)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Admin User",
  "email": "admin@meritix.com",
  "password": "Admin@123",
  "role": "ADMIN"
}

###

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@meritix.com",
  "password": "Admin@123"
}

############################################################
# Copy access_token from above response
############################################################

@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjMsImVtYWlsIjoiYWRtaW5AbWVyaXRpeC5jb20iLCJyb2xlIjoiQURNSU4iLCJpYXQiOjE3ODUzMTIyMjgsImV4cCI6MTc4NTM5ODYyOH0.E-FSzqBGJs7lr_hokkz7ksoaRgBLzjEefW6kbG1uLDA

############################################################
# CREATE SCHOOL
############################################################

###
POST {{baseUrl}}/schools
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "DPSJPR",
  "name": "Delhi Public School Jaipur",
  "boardId": 1,
  "udiseCode": "08123456789",
  "affiliationNo": "CBSE12345",
  "principalName": "Dr Rajesh Sharma",
  "email": "info@dpsjaipur.edu.in",
  "phone": "9876543210",
  "website": "https://www.dpsjaipur.edu.in",
  "address": "Ajmer Road",
  "city": "Jaipur",
  "state": "Rajasthan",
  "country": "India",
  "pincode": "302001",
  "isActive": true
}

############################################################
# GET ALL SCHOOLS
############################################################

###
GET {{baseUrl}}/schools
Authorization: Bearer {{token}}

############################################################
# GET SCHOOL BY ID
############################################################

###
GET {{baseUrl}}/schools/1
Authorization: Bearer {{token}}

############################################################
# GET SCHOOL BY CODE
############################################################

###
GET {{baseUrl}}/schools/code/DPSJPR
Authorization: Bearer {{token}}

############################################################
# GET SCHOOLS BY BOARD
############################################################

###
GET {{baseUrl}}/schools/board/1
Authorization: Bearer {{token}}

############################################################
# UPDATE SCHOOL
############################################################

###
PATCH {{baseUrl}}/schools/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Delhi Public School Jaipur Updated",
  "city": "New Jaipur",
  "principalName": "Dr Amit Sharma",
  "phone": "9999999999"
}

############################################################
# ACTIVATE SCHOOL
############################################################

###
PATCH {{baseUrl}}/schools/1/activate
Authorization: Bearer {{token}}

############################################################
# DEACTIVATE SCHOOL
############################################################

###
PATCH {{baseUrl}}/schools/1/deactivate
Authorization: Bearer {{token}}

############################################################
# DELETE SCHOOL
############################################################

###
DELETE {{baseUrl}}/schools/1
Authorization: Bearer {{token}}