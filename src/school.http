############################################################
### MERITIX - SCHOOL MODULE
############################################################

@baseUrl = http://localhost:3000

############################################################
### LOGIN
############################################################

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@meritix.com",
  "password": "Password123"
}

###

############################################################
### COPY TOKEN FROM LOGIN RESPONSE
############################################################

@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjMsImVtYWlsIjoiYWRtaW5AbWVyaXRpeC5jb20iLCJyb2xlIjoiQURNSU4iLCJpYXQiOjE3ODUzNDgyMzMsImV4cCI6MTc4NTQzNDYzM30.OSL7HwafyEXg3UHiPkD6oV_v_MrnP2W6PHcKhUuGqC8

############################################################
### GET ALL BOARDS (Run First)
############################################################

GET {{baseUrl}}/boards
Authorization: Bearer {{token}}

###
# NOTE:
# Use one of the returned Board IDs.
# Example:
# ICSE = 2
# RBSE = 3
# CBSE = 4

############################################################
### CREATE SCHOOL
############################################################

POST {{baseUrl}}/schools
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "DPSJPR",
  "name": "Delhi Public School Jaipur",
  "boardId": 4,
  "udiseCode": "08123456789",
  "affiliationNo": "CBSE12345",
  "principalName": "Dr Rajesh Sharma",
  "email": "info@dpsjaipur.edu.in",
  "phone": "9876543210",
  "website": "https://www.dpsjaipur.edu.in",
  "address": "Ajmer Road",
  "city": "Jaipur",
  "state": "Rajasthan",
  "country": "India",
  "pincode": "302001",
  "isActive": true
}

###

############################################################
### GET ALL SCHOOLS
############################################################

GET {{baseUrl}}/schools
Authorization: Bearer {{token}}

###
# Copy the School ID returned below.
# Example:
# id = 5

############################################################
### GET SCHOOL BY ID
############################################################

GET {{baseUrl}}/schools/1
Authorization: Bearer {{token}}

############################################################
### GET SCHOOL BY CODE
############################################################

GET {{baseUrl}}/schools/code/DPSJPR
Authorization: Bearer {{token}}

############################################################
### GET SCHOOLS BY BOARD
############################################################

GET {{baseUrl}}/schools/board/4
Authorization: Bearer {{token}}

############################################################
### UPDATE SCHOOL
############################################################

PATCH {{baseUrl}}/schools/5
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Delhi Public School Jaipur Updated",
  "city": "New Jaipur",
  "principalName": "Dr Amit Sharma",
  "phone": "9999999999"
}

############################################################
### DEACTIVATE SCHOOL
############################################################

PATCH {{baseUrl}}/schools/5/deactivate
Authorization: Bearer {{token}}

############################################################
### ACTIVATE SCHOOL
############################################################

PATCH {{baseUrl}}/schools/5/activate
Authorization: Bearer {{token}}

############################################################
### DELETE SCHOOL
############################################################



POST http://localhost:3000/schools
Authorization: Bearer YOUR_TOKEN
Content-Type: application/json

{
  "code": "DPSJPR",
  "name": "Delhi Public School Jaipur",
  "boardId": 4,
  "city": "Jaipur",
  "state": "Rajasthan"
}

PATCH {{baseUrl}}/schools/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Delhi Public School Jaipur Updated",
  "city": "New Jaipur",
  "principalName": "Dr Amit Sharma",
  "phone": "9999999999"
}