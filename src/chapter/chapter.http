### ============================================================
### Create Chapter
### ============================================================

POST {{baseUrl}}/chapters
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "subjectId": 1,
  "code": "ALG",
  "name": "Algebra",
  "description": "Algebra fundamentals",
  "sequence": 1,
  "isActive": true
}

###

### Create Chapter 2

POST {{baseUrl}}/chapters
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "subjectId": 1,
  "code": "GEO",
  "name": "Geometry",
  "description": "Geometry basics",
  "sequence": 2
}

###

### Get All Chapters

GET {{baseUrl}}/chapters
Authorization: Bearer {{token}}

###

### Get Chapter By ID

GET {{baseUrl}}/chapters/1
Authorization: Bearer {{token}}

###

### Get Chapters By Subject

GET {{baseUrl}}/chapters/subject/1
Authorization: Bearer {{token}}

###

### Update Chapter

PATCH {{baseUrl}}/chapters/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Advanced Algebra",
  "sequence": 5
}

###

### Activate Chapter

PATCH {{baseUrl}}/chapters/1/activate
Authorization: Bearer {{token}}

###

### Deactivate Chapter

PATCH {{baseUrl}}/chapters/1/deactivate
Authorization: Bearer {{token}}

###

### Delete Chapter

DELETE {{baseUrl}}/chapters/2
Authorization: Bearer {{token}}

